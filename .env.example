# Clave de Deepgram (https://console.deepgram.com) -> API Keys
DEEPGRAM_API_KEY=

# Se rellena sola al conectar un Blob store al proyecto en Vercel
BLOB_READ_WRITE_TOKEN=

# Contraseña que le pasas a tu amiga
APP_PASSWORD=

# Cadena aleatoria larga (por ejemplo: openssl rand -hex 32)
SESSION_SECRET=
